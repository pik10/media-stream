# Backend Environment Configuration
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3000
NODE_ENV=production

# Security - REQUIRED (Generate with: openssl rand -base64 32)
# IMPORTANT: These MUST be set, the application will not start without them
JWT_SECRET=your-secure-jwt-secret-here-generate-with-openssl-rand
ENCRYPTION_KEY=your-secure-encryption-key-here-generate-with-openssl-rand

# CORS Configuration
# Set this to your frontend URL in production
FRONTEND_URL=http://localhost:5173

# Quick Setup Commands:
# Generate JWT_SECRET:     openssl rand -base64 32
# Generate ENCRYPTION_KEY: openssl rand -base64 32
